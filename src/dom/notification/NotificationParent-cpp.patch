+using NotificationIconPromise = MozPromise<Maybe<IPCImage>, nsresult, true>;
+
+static RefPtr<NotificationIconPromise> GetCachedNotificationIcon(
+    nsIPrincipal* aPrincipal) {
+  nsCOMPtr<nsIURI> uri;
+  aPrincipal->GetURI(getter_AddRefs(uri));
+  // Only web origins may consult the non-private Places cache.
+  if (!uri || (!uri->SchemeIs("https") && !uri->SchemeIs("http"))) {
+    return NotificationIconPromise::CreateAndResolve(Nothing(), __func__);
+  }
+  RefPtr<nsFaviconService> favicons = nsFaviconService::GetFaviconService();
+  if (!favicons) {
+    return NotificationIconPromise::CreateAndResolve(Nothing(), __func__);
+  }
+
+  RefPtr<NotificationIconPromise::Private> promise =
+      new NotificationIconPromise::Private(__func__);
+  nsCOMPtr<nsITimer> timer;
+  // Favicon lookup and decoding must not hold up delivery. MozPromise accepts
+  // only the first resolution, so a late result cannot show the alert twice.
+  nsresult rv = NS_NewTimerWithCallback(
+      getter_AddRefs(timer),
+      [promise](nsITimer*) { promise->Resolve(Nothing(), __func__); }, 200,
+      nsITimer::TYPE_ONE_SHOT, "Notification favicon timeout"_ns);
+  if (NS_FAILED(rv)) {
+    promise->Resolve(Nothing(), __func__);
+    return promise;
+  }
+
+  favicons->AsyncGetFaviconForPage(uri, 64)
+      ->Then(GetMainThreadSerialEventTarget(), __func__,
+             [principal = nsCOMPtr<nsIPrincipal>(aPrincipal)](
+                 const places::FaviconPromise::ResolveOrRejectValue& aResult) {
+               nsCOMPtr<nsIURI> dataURI;
+               if (aResult.IsReject() || !aResult.ResolveValue() ||
+                   NS_FAILED(aResult.ResolveValue()->GetDataURI(
+                       getter_AddRefs(dataURI)))) {
+                 return image::FetchDecodedImagePromise::CreateAndReject(
+                     NS_ERROR_NOT_AVAILABLE, __func__);
+               }
+               // Decode only the cached bytes, never the favicon's network URL.
+               return image::FetchDecodedImage(
+                   dataURI, gfx::IntSize{}, principal,
+                   nsILoadInfo::SEC_ALLOW_CROSS_ORIGIN_SEC_CONTEXT_IS_NULL,
+                   nsIContentPolicy::TYPE_INTERNAL_IMAGE_NOTIFICATION);
+             })
+      ->Then(
+          GetMainThreadSerialEventTarget(), __func__,
+          [promise, timer](already_AddRefed<imgIContainer> aImage) {
+            timer->Cancel();
+            nsCOMPtr<imgIContainer> image(std::move(aImage));
+            Maybe<IPCImage> icon;
+            // A fixed size also supports SVG favicons with only a viewBox.
+            if (RefPtr<gfx::SourceSurface> surface = image->GetFrameAtSize(
+                    gfx::IntSize(64, 64), imgIContainer::FRAME_FIRST,
+                    imgIContainer::FLAG_SYNC_DECODE |
+                        imgIContainer::FLAG_ASYNC_NOTIFY)) {
+              if (RefPtr<gfx::DataSourceSurface> dataSurface =
+                      surface->GetDataSurface()) {
+                icon = nsContentUtils::SurfaceToIPCImage(*dataSurface);
+              }
+            }
+            promise->Resolve(std::move(icon), __func__);
+          },
+          [promise, timer](nsresult) {
+            timer->Cancel();
+            promise->Resolve(Nothing(), __func__);
+          });
+  return promise;
+}
+#endif
