+
+#minimize {
+  background-image: url("chrome://browser/skin/zen-icons/unpin.svg");
+  background-color: rgba(255, 255, 255, .8);
+  position: absolute;
+  fill: var(--close-btn-fill-color);
+  right: 50px;
+  top: 10px;
+}
+
+#minimize[mac="true"] {
+  right: auto;
+  left: 50px;
+}
+
+#playbackRate {
+  grid-area: playbackrate;
+  background-image: url("chrome://browser/skin/zen-icons/speedometer.svg");
+}
+
+/* .panel-fieldset only resets the fieldset's default start padding, leaving
+ * the default end padding behind; zero it so both sides pad equally. */
+#playbackRateSettings .panel-fieldset {
+  padding-inline-end: 0;
+}
+
+.playback-rate-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  padding: 10px 8px 0;
+  font-family: sans-serif;
+  color: white;
+}
+
+#playback-rate-value {
+  font-variant-numeric: tabular-nums;
+  font-weight: var(--font-weight-semibold);
+  color: #00ddff;
+}
+
+#playback-rate-slider {
+  appearance: none;
+  background: transparent;
+  width: calc(100% - 16px);
+  margin: 12px 8px 4px;
+
+  &::-moz-range-track {
+    background-color: #55545f;
+    height: 4px;
+    border-radius: var(--border-radius-medium);
+  }
+
+  &::-moz-range-progress {
+    background-color: #00ddff;
+    height: 4px;
+    border-radius: var(--border-radius-medium);
+  }
+
+  &::-moz-range-thumb {
+    background-color: #ffffff;
+    border: none;
+    width: 12px;
+    height: 12px;
+    border-radius: var(--border-radius-circle);
+  }
+}
+
+.playback-rate-presets {
+  display: flex;
+  gap: 4px;
+  padding: 6px 8px 12px;
+}
+
+.playback-rate-preset {
+  flex: 1;
+  background-color: #55545f;
+  color: white;
+  border: none;
+  border-radius: var(--border-radius-small);
+  font-family: sans-serif;
+  font-size: 0.8em;
+  font-variant-numeric: tabular-nums;
+  padding: 4px 0;
+  cursor: pointer;
+}
+
+.playback-rate-preset:hover {
+  background-color: #6b6a78;
+}
+
+.playback-rate-preset.selected {
+  background-color: #00ddff;
+  color: #2b2a33;
+}
