+  updateTheme(aTooltip) {
+    if (!aTooltip) {
+      return;
+    }
+
+    let trigger = aTooltip.triggerNode;
+    let effectiveTrigger = trigger;
+    if (trigger && !trigger.hasAttribute("tooltiptext") && !trigger.hasAttribute("title") && !trigger.id) {
+      let parentWithTooltip = trigger.closest("[tooltiptext], [title], [id]");
+      if (parentWithTooltip) {
+        effectiveTrigger = parentWithTooltip;
+      }
+    }
+
+    try {
+      let schemePref = Services.prefs.getIntPref("zen.view.window.scheme", 2);
+      let isDark = null;
+      let primaryColor = null;
+
+      // 1. Resolve workspace context from trigger (if hovering a workspace icon or workspace tab)
+      let ws = null;
+      let wsId = trigger?.getAttribute("zen-workspace-id") ||
+                 effectiveTrigger?.getAttribute("zen-workspace-id") ||
+                 trigger?.closest("[zen-workspace-id]")?.getAttribute("zen-workspace-id");
+      if (wsId && window.gZenWorkspaces) {
+        ws = window.gZenWorkspaces.getWorkspaceFromId?.(wsId);
+      }
+      if (!ws && window.gZenWorkspaces) {
+        ws = window.gZenWorkspaces.getActiveWorkspace?.();
+      }
+
+      // 2. Get workspace theme data (colors and mode)
+      let wsThemeData = null;
+      if (ws && window.gZenThemePicker) {
+        wsThemeData = window.gZenThemePicker.getGradientForWorkspace?.(ws, { getGradient: false }) ||
+                      window.gZenThemePicker.getWorkspaceTheme?.(ws);
+      }
+
+      // 3. Resolve primary color
+      if (trigger) {
+        let explicitColor = trigger.closest("[zen-should-be-dark-mode]")?.style?.getPropertyValue("--zen-primary-color");
+        if (explicitColor && explicitColor.trim() !== "") {
+          primaryColor = explicitColor.trim();
+        }
+      }
+      if (!primaryColor && wsThemeData?.primaryColor) {
+        primaryColor = wsThemeData.primaryColor;
+      }
+      if (!primaryColor) {
+        let computed = effectiveTrigger ? window.getComputedStyle(effectiveTrigger) : null;
+        let c = computed?.getPropertyValue("--zen-primary-color");
+        if (c && c.trim() !== "") {
+          primaryColor = c.trim();
+        } else {
+          primaryColor = window.getComputedStyle(document.documentElement).getPropertyValue("--zen-primary-color")?.trim();
+        }
+      }
+
+      // 4. Resolve dark vs light mode:
+      if (schemePref === 0) {
+        isDark = true;
+      } else if (schemePref === 1) {
+        isDark = false;
+      } else {
+        // Auto (schemePref === 2):
+        let darkElem = trigger?.closest?.("[zen-should-be-dark-mode]");
+        if (darkElem && darkElem !== document.documentElement) {
+          let val = darkElem.getAttribute("zen-should-be-dark-mode");
+          if (val === "true") {
