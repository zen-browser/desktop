 }
 
+bool MediaStatusManager::IsTopLevelSessionActionSupported(
+    MediaControlKey aKey) const {
+  if (!HasTopLevelDelegation()) {
+    return false;
+  }
+  auto info = mMediaSessionInfoMap.Lookup(mTopLevelBrowsingContextId);
+  if (info) {
+    for (MediaSessionAction action :
+         MakeWebIDLEnumeratedRange<MediaSessionAction>()) {
+      if (info->IsActionSupported(action) &&
+          ConvertMediaSessionActionToControlKey(action) == aKey) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
