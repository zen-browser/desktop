EXTRA_JS_MODULES.zen.boosts += [
  "ZenBoostReceiveDialog.mjs",
  "ZenBoostsEditor.mjs",
  "ZenBoostShareDialog.mjs",
  "ZenBoostsManager.sys.mjs",
  "ZenSelectorComponent.sys.mjs",
  "ZenZapDissolve.sys.mjs",
  "ZenZapOverlayChild.sys.mjs",
]

FINAL_TARGET_FILES.actors += [
    "actors/ZenBoostsChild.sys.mjs",
    "actors/ZenBoostsParent.sys.mjs",
]

XPIDL_SOURCES += [
    "nsIZenBoostsBackend.idl",
]

EXPORTS.mozilla += [
    "nsZenBoostData.h",
    "nsZenBoostsBackend.h",
    "nsZenBoostsContentSheets.h",
    "nsZenBoostsStyle.h",
]

SOURCES += [
    "nsZenBCOverrides.cpp",
    "nsZenBoostData.cpp",
    "nsZenBoostsBackend.cpp",
    "nsZenBoostsColorFilter.cpp",
    "nsZenBoostsContentSheets.cpp",
    "nsZenBoostsStyle.cpp",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"
XPIDL_MODULE = "zen_boosts"

TEST_DIRS += [
    "gtest",
]
