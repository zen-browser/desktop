+      } else {
+        aTooltip.style.removeProperty("--zen-primary-color");
+      }
+
+      aTooltip.setAttribute("scheme", isDark ? "dark" : "light");
+      aTooltip.style.colorScheme = isDark ? "dark" : "light";
+    } catch (e) {
