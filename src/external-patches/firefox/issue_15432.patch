+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+// A spawn failure must always reject with a descriptive error. When the
+// worker-side error could not be structured-cloned, it used to arrive as an
+// empty object, which native messaging then reported as "undefined" and
+// forwarded to extensions in a form that broke the port disconnect
+// (gh-15432).
+add_task(async function test_subprocess_spawn_failure_message() {
+  const path = PathUtils.join(
+    PathUtils.tempDir,
+    "subprocess-test-not-executable.txt"
+  );
+  await IOUtils.writeUTF8(path, "this is not an executable file");
+
+  let error;
+  try {
+    await Subprocess.call({ command: path, stderr: "pipe" });
+  } catch (e) {
+    error = e;
+  }
+
+  ok(error, "Subprocess.call rejects for a non-executable file");
+  ok(error instanceof Error, `The rejection value is an Error, got ${error}`);
+  ok(
+    typeof error.message == "string" && error.message.length > 0,
+    `The rejection carries a message: ${error.message}`
+  );
+});
