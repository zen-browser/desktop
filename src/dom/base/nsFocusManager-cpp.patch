+static nsPIDOMWindowOuter* ZenKeptActiveOpener(nsPIDOMWindowOuter* aWindow) {
+  mozilla::dom::Document* doc = aWindow ? aWindow->GetExtantDoc() : nullptr;
+  mozilla::dom::Element* root = doc ? doc->GetRootElement() : nullptr;
+  if (!root || !root->HasAttribute(u"zen-keep-opener-active"_ns)) {
+    return nullptr;
+  }
+  return nsGlobalWindowOuter::Cast(aWindow)->GetSameProcessOpener();
+}
+
+static bool ZenIsActiveBrowserWindow(nsPIDOMWindowOuter* aWindow) {
+  BrowsingContext* bc = aWindow->GetBrowsingContext();
+  return bc && bc->GetIsActiveBrowserWindow();
+}
