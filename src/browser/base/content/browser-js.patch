+   */
+  parseShortcutKeys(shortcut) {
+    if (!shortcut) {
+      return [];
+    }
+    if (/[⌘⌥⇧⌃]/.test(shortcut)) {
+      return shortcut.match(/[⌘⌥⇧⌃]|[^⌘⌥⇧⌃]+/gu);
