+    document.addEventListener(eventName, initBound, { once: true });
+    return;
+  }
+  const features = window.gZenLazyFeatures;
+  if (features?.holdInit) {
+    features.takeInit(initBound);
+    return;
+  }
+  queueMicrotask(initBound);
