#include "nsISupports.idl"
#include "nsIURI.idl"

%{C++
#include "mozilla/ServoStyleSet.h"
#include "mozilla/dom/Document.h"
%}

/**
 * @brief Interface for Zen mods backend.
 */
[scriptable, uuid(a0ee4792-b186-4497-936d-53a8989fe836)]
interface nsIZenModsBackend : nsISupports {
  /**
   * @brief Reload chrome/zen-themes.css from disk and apply it.
   * The sheet and its @import rules load synchronously, so every mod file
   * is read again, and the new sheet replaces the old one in every chrome
   * document.
   * @returns void
   */
  void reloadModsStyles();
};
