+      (*mActiveMediaSessionContextId != aBrowsingContextId &&
+       (aBrowsingContextId != mTopLevelBrowsingContextId ||
+        !HasTopLevelDelegation()))) {
     return;
   }
   mSupportedActionsChangedEvent.Notify(GetSupportedActions());
@@ -448,15 +484,36 @@ CopyableTArray<MediaSessionAction> MediaStatusManager::GetSupportedActions()
 
   MediaSessionInfo info =
       mMediaSessionInfoMap.Get(*mActiveMediaSessionContextId);
+  auto topLevelInfo = mMediaSessionInfoMap.Lookup(mTopLevelBrowsingContextId);
   for (MediaSessionAction action :
        MakeWebIDLEnumeratedRange<MediaSessionAction>()) {
-    if (info.IsActionSupported(action)) {
+    if (info.IsActionSupported(action) ||
+        (HasTopLevelDelegation() && topLevelInfo &&
+         topLevelInfo->IsActionSupported(action))) {
       supportedActions.AppendElement(action);
     }
