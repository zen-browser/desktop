+void NotificationParent::FinishShow(Maybe<IPCImage>&& aIcon) {
+  mShowPending = false;
+  // Always register with the alert system before processing a pending close.
+  nsresult rv = Show(std::move(aIcon));
+  // Show may synchronously call NotificationCallbacks and consume mResolver.
+  if (NS_FAILED(rv) && mResolver) {
+    mResolver.take().value()(CopyableErrorResult(rv));
+  }
+  // Otherwise NotificationCallbacks resolves the show request.
+  if (mClosePending) {
+    mClosePending = false;
+    Unregister();
+    Close();
+  }
+}
