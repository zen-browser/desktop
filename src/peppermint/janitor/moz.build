MOZ_SRC_FILES += [
    "PeppermintJanitor.sys.mjs",
    "PeppermintJanitorCleaner.sys.mjs",
    "PeppermintJanitorTargets.sys.mjs",
]

# A ChromeWorker needs a resource:/// URL, like the adblock compiler.
EXTRA_JS_MODULES.zen.janitor += [
    "PeppermintJanitorRecycleBin.worker.mjs",
]
