+static constexpr auto kZenLinuxTransparencyPref =
+    "zen.widget.linux.transparency"_ns;
+
+static void ZenLinuxTransparencyPrefChanged(const char* aPref, void* aClosure) {
+  static_cast<nsWindowWayland*>(aClosure)->UpdateBackgroundEffect();
+}
+
+void nsWindowWayland::ClearBackgroundEffect() {
+  if (!mBackgroundEffect) {
+    mBackgroundEffectSurface = nullptr;
+    return;
+  }
+
+  wl_surface* surface = mBackgroundEffectSurface;
+  ext_background_effect_surface_v1_destroy(mBackgroundEffect);
+  mBackgroundEffect = nullptr;
+  mBackgroundEffectSurface = nullptr;
+
+  if (surface) {
+    wl_surface_commit(surface);
+  }
+}
+
+void nsWindowWayland::UpdateBackgroundEffect() {
+  const bool transparencyEnabled =
+      Preferences::GetBool(kZenLinuxTransparencyPref.get(), false);
+
+  if (mWindowType != WindowType::TopLevel || mPiPType != PiPType::NoPiP ||
+      !transparencyEnabled) {
+    ClearBackgroundEffect();
+    return;
+  }
+
+  GdkWindow* gdkWindow = GetToplevelGdkWindow();
+  if (!gdkWindow) {
+    ClearBackgroundEffect();
+    return;
+  }
+
+  wl_surface* gdkSurface = gdk_wayland_window_get_wl_surface(gdkWindow);
+  wl_surface* renderSurface = nullptr;
+  DesktopIntSize surfaceSize;
+  if (mSurface) {
+    WaylandSurfaceLock lock(mSurface);
+    renderSurface = mSurface->GetWlSurfaceLocked(lock);
+    surfaceSize = mSurface->GetSizeLocked(lock);
+  }
+  wl_surface* surface = renderSurface ? renderSurface : gdkSurface;
+
+  nsWaylandDisplay* display = WaylandDisplayGet();
+  if (!surface || !display || !display->GetCompositor() ||
+      !display->GetBackgroundEffectManager() ||
+      !display->BackgroundEffectSupportsBlur()) {
+    ClearBackgroundEffect();
+    return;
+  }
+
+  if (mBackgroundEffectSurface != surface) {
+    ClearBackgroundEffect();
+  }
+
+  if (!mBackgroundEffect) {
+    ext_background_effect_manager_v1* manager =
+        display->GetBackgroundEffectManager();
+    mBackgroundEffect = ext_background_effect_manager_v1_get_background_effect(
+        manager, surface);
+    mBackgroundEffectSurface = surface;
+  }
+
+  wl_region* region = wl_compositor_create_region(display->GetCompositor());
+  if (!region) {
+    ClearBackgroundEffect();
+    return;
+  }
+
+  const int gdkWidth = gdk_window_get_width(gdkWindow);
+  const int gdkHeight = gdk_window_get_height(gdkWindow);
+  const int width = renderSurface ? surfaceSize.width : gdkWidth;
+  const int height = renderSurface ? surfaceSize.height : gdkHeight;
+  if (width <= 0 || height <= 0) {
+    wl_region_destroy(region);
+    ClearBackgroundEffect();
+    return;
+  }
+
+  wl_region_add(region, 0, 0, width, height);
+  ext_background_effect_surface_v1_set_blur_region(mBackgroundEffect, region);
+  wl_surface_commit(surface);
+  wl_region_destroy(region);
+}
