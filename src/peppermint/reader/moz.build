MOZ_SRC_FILES += [
    "PeppermintReader.sys.mjs",
    "PeppermintReaderAvailability.sys.mjs",
    "PeppermintReaderImages.sys.mjs",
    "PeppermintReaderStore.sys.mjs",
]

# Registered through components.conf, which needs a resource:/// URL.
EXTRA_JS_MODULES.zen.reader += [
    "PeppermintAboutSaved.sys.mjs",
]

XPCOM_MANIFESTS += [
    "components.conf",
]
