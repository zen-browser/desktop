+NS_IMETHODIMP
+nsMacDockSupport::GetIsApplicationActive(bool* aIsActive) {
+  NS_OBJC_BEGIN_TRY_BLOCK_RETURN;
+
+  *aIsActive = [[NSApplication sharedApplication] isActive];
+  return NS_OK;
+
+  NS_OBJC_END_TRY_BLOCK_RETURN(NS_ERROR_FAILURE);
+}
+
+NS_IMETHODIMP
+nsMacDockSupport::GetMillisecondsSinceApplicationActivated(int64_t* aElapsed) {
+  NS_OBJC_BEGIN_TRY_BLOCK_RETURN;
+
+  EnsureApplicationActivationObserver();
+  if (sApplicationActivatedAt < 0.0) {
+    *aElapsed = -1;
+    return NS_OK;
+  }
+
+  NSTimeInterval elapsed =
+      [NSDate timeIntervalSinceReferenceDate] - sApplicationActivatedAt;
+  *aElapsed = elapsed <= 0.0 ? 0 : (int64_t)(elapsed * 1000.0);
+  return NS_OK;
+
+  NS_OBJC_END_TRY_BLOCK_RETURN(NS_ERROR_FAILURE);
+}
+
+NS_IMETHODIMP
+nsMacDockSupport::HideApplication() {
+  NS_OBJC_BEGIN_TRY_BLOCK_RETURN;
+
+  NSRunningApplication* previousApplication =
+      [[sPreviousApplication retain] autorelease];
+  if (!previousApplication || previousApplication.terminated) {
+    return NS_OK;
+  }
+
+  if (@available(macOS 14.0, *)) {
+    [[NSApplication sharedApplication]
+        yieldActivationToApplication:previousApplication];
+    return [previousApplication activateWithOptions:0] ? NS_OK
+                                                       : NS_ERROR_FAILURE;
+  }
+
+  return [previousApplication
+             activateWithOptions:NSApplicationActivateIgnoringOtherApps]
+             ? NS_OK
+             : NS_ERROR_FAILURE;
+
+  NS_OBJC_END_TRY_BLOCK_RETURN(NS_ERROR_FAILURE);
+}
+
+NS_IMETHODIMP
+nsMacDockSupport::MakeWindowJoinActiveSpace(nsIBaseWindow* aWindow) {
+  NS_OBJC_BEGIN_TRY_BLOCK_RETURN;
+
+  if (!aWindow) {
+    return NS_ERROR_INVALID_ARG;
+  }
+
+  nsCOMPtr<nsIWidget> widget = aWindow->GetMainWidget();
+  if (!widget) {
+    return NS_ERROR_FAILURE;
+  }
+
+  NSWindow* nativeWindow = (NSWindow*)widget->GetNativeData(NS_NATIVE_WINDOW);
+  if (!nativeWindow) {
+    return NS_ERROR_FAILURE;
+  }
+
+  // MoveToActiveSpace is the point of this: the window goes to the user rather
+  // than the user being taken to the window. A window that follows the user
+  // has no business taking a Space of its own, so native fullscreen is swapped
+  // for the auxiliary behaviour. All four fullscreen bits are set explicitly,
+  // the way nsCocoaWindow::SetSupportsNativeFullscreen does, because leaving
+  // any of them unset lets AppKit fall back to a heuristic that is not stable.
+  NSWindowCollectionBehavior behavior = [nativeWindow collectionBehavior];
+  behavior &= ~(NSWindowCollectionBehaviorFullScreenPrimary |
+                NSWindowCollectionBehaviorFullScreenAuxiliary |
+                NSWindowCollectionBehaviorFullScreenAllowsTiling |
+                NSWindowCollectionBehaviorFullScreenDisallowsTiling);
+  behavior |= NSWindowCollectionBehaviorMoveToActiveSpace |
+              NSWindowCollectionBehaviorFullScreenAuxiliary |
+              NSWindowCollectionBehaviorFullScreenDisallowsTiling;
+
+  // macOS 13 replaced those fullscreen bits with a three-way, mutually
+  // exclusive Stage Manager and fullscreen role. CanJoinAllApplications is
+  // the only one of the three that lets an ordinary window appear on the
+  // Space of another application's fullscreen window, which is exactly the
+  // case an external link opened from a fullscreen app lands in. It governs
+  // Space eligibility and nothing else: the window keeps a normal window
+  // level, so the user can still send it behind, move it, and leave it where
+  // they put it.
+  if (@available(macOS 13.0, *)) {
+    behavior &= ~(NSWindowCollectionBehaviorPrimary |
+                  NSWindowCollectionBehaviorAuxiliary);
+    behavior |= NSWindowCollectionBehaviorCanJoinAllApplications;
+  }
+
+  [nativeWindow setCollectionBehavior:behavior];
+  return NS_OK;
+
+  NS_OBJC_END_TRY_BLOCK_RETURN(NS_ERROR_FAILURE);
+}
