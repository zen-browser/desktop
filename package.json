{
  "name": "peppermint-desktop",
  "version": "1.0.0",
  "description": "",
  "lint-staged": {
    "**/*": ""
  },
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-async-icns.mjs && node peppermint/scripts/setup-git.mjs",
    "build": "surfer build",
    "prebuild": "node scripts/run-python.mjs scripts/update_en_US_packs.py",
    "build:ui": "surfer build --ui",
    "prebuild:ui": "node scripts/run-python.mjs scripts/update_en_US_packs.py",
    "start": "cd engine && node ../scripts/run-python.mjs ./mach run --noprofile",
    "start:bloat": "XPCOM_MEM_BLOAT_LOG=1 npm start",
    "import": "npm run ffprefs && npm run import:dumps && node peppermint/scripts/apply-overlay.mjs revert && node scripts/reset-preferences-before-import.mjs && node peppermint/scripts/surfer-import.mjs && node peppermint/scripts/prune-engine-links.mjs && node scripts/apply-engine-patches.mjs && node scripts/ensure-jar-manifest-patches.mjs && node peppermint/scripts/apply-overlay.mjs apply && node scripts/run-python.mjs scripts/update_en_US_packs.py",
    "import:dumps": "node scripts/run-python.mjs scripts/update_service_dumps.py",
    "export": "surfer export",
    "init": "npm run download && npm run import && npm run bootstrap",
    "download": "surfer download",
    "bootstrap": "surfer bootstrap",
    "package": "surfer package",
    "sync": "node scripts/run-python.mjs scripts/update_ff.py",
    "sync:raw": "surfer update",
    "sync:rc": "node scripts/run-python.mjs scripts/update_ff.py --rc",
    "sync:l10n": "node scripts/run-python.mjs scripts/update_ff.py --just-l10n",
    "lint": "cd engine && ./mach lint zen peppermint",
    "lint:fix": "npm run lint -- --fix",
    "reset-ff": "surfer reset",
    "surfer": "surfer",
    "test": "node scripts/run-python.mjs scripts/run_tests.py",
    "test:dbg": "node scripts/run-python.mjs scripts/run_tests.py --jsdebugger --debug-on-failure",
    "test:gtest": "cd engine && ./mach gtest Zen*",
    "ffprefs": "cd tools/ffprefs && cargo run --bin ffprefs -- ../../",
    "lc": "surfer license-check",
    "lc:fix": "surfer license-check --fix",
    "use-moz-src": "cd engine && ./mach use-moz-src",
    "ci": "surfer ci --brand release --display-version",
    "audit:fix-safe": "node scripts/npm-audit-safe-fix.mjs",
    "pm:record": "node peppermint/scripts/record-patch.mjs",
    "pm:verify": "node peppermint/scripts/verify.mjs compare peppermint/baseline/engine-snapshot.json --moves peppermint/baseline/moves.json --allow peppermint/baseline/allow.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AstroDevCompany/desktop.git"
  },
  "keywords": [],
  "author": "",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/AstroDevCompany/desktop/issues"
  },
  "homepage": "https://github.com/AstroDevCompany/desktop#readme",
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.0",
    "@zen-browser/prettier": "^3.9.3",
    "@zen-browser/surfer": "^1.14.9",
    "formal-git": "^1.2.9",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "typescript": "^5.9.3"
  },
  "notes(private)": "We don't want to publish to npm, so this is marked as private",
  "private": true,
  "overrides": {
    "sharp": "0.35.5"
  }
}
