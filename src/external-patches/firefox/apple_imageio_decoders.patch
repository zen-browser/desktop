+#ifndef mozilla_image_decoders_nsImageIODecoder_h
+#define mozilla_image_decoders_nsImageIODecoder_h
+
+#include "Decoder.h"
+#include "mozilla/Vector.h"
+#include "SurfacePipe.h"
+
+namespace mozilla::image {
+
+class nsImageIODecoder final : public Decoder {
+ public:
+  DecoderType GetType() const override { return DecoderType::IMAGEIO; }
+
+ protected:
+  LexerResult DoDecode(SourceBufferIterator& aIterator,
+                       IResumable* aOnResume) override;
+  Maybe<glean::impl::MemoryDistributionMetric> SpeedMetric() const override;
+
+ private:
+  friend class DecoderFactory;
+  explicit nsImageIODecoder(RasterImage* aImage) : Decoder(aImage) {}
+  LexerResult DecodeCompleteSource();
+
+  Vector<uint8_t> mEncodedData;
+  bool mSourceComplete = false;
+};
+
+}  // namespace mozilla::image
+
+#endif
--- a/image/decoders/nsImageIODecoder.cpp
+++ b/image/decoders/nsImageIODecoder.cpp
@@ -0,0 +1,192 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsImageIODecoder.h"
+
+#include <algorithm>
+
+#include <CoreGraphics/CoreGraphics.h>
+#include <ImageIO/ImageIO.h>
+
+#include "RasterImage.h"
+#include "SurfacePipeFactory.h"
+
+namespace mozilla::image {
+
+static constexpr size_t kMaxEncodedBytes = 256 * 1024 * 1024;
+static constexpr size_t kMaxDecodedBytes = 512 * 1024 * 1024;
+static constexpr size_t kMaxImageDimension = 32768;
+
+Maybe<glean::impl::MemoryDistributionMetric> nsImageIODecoder::SpeedMetric()
+    const {
+  return Nothing();
+}
+
+LexerResult nsImageIODecoder::DoDecode(SourceBufferIterator& aIterator,
+                                       IResumable* aOnResume) {
+  while (!mSourceComplete) {
+    if (!aIterator.IsReady() || aIterator.Length() == 0) {
+      SourceBufferIterator::State state =
+          aIterator.AdvanceOrScheduleResume(SIZE_MAX, aOnResume);
+      if (state == SourceBufferIterator::WAITING) {
+        return LexerResult(Yield::NEED_MORE_DATA);
+      }
+      if (state == SourceBufferIterator::COMPLETE) {
+        if (NS_FAILED(aIterator.CompletionStatus())) {
+          return LexerResult(TerminalState::FAILURE);
+        }
+        mSourceComplete = true;
+        break;
+      }
+    }
+
+    const size_t length = aIterator.Length();
+    if (length > kMaxEncodedBytes - mEncodedData.length() ||
+        !mEncodedData.append(reinterpret_cast<const uint8_t*>(aIterator.Data()),
+                             length)) {
+      return LexerResult(TerminalState::FAILURE);
+    }
+    aIterator.MarkConsumed(length);
+  }
+  return DecodeCompleteSource();
+}
+
+LexerResult nsImageIODecoder::DecodeCompleteSource() {
+  if (mEncodedData.empty()) {
+    return LexerResult(TerminalState::FAILURE);
+  }
+
+  CFDataRef data = CFDataCreate(nullptr, mEncodedData.begin(),
+                                static_cast<CFIndex>(mEncodedData.length()));
+  if (!data) {
+    return LexerResult(TerminalState::FAILURE);
+  }
+  CGImageSourceRef source = CGImageSourceCreateWithData(data, nullptr);
+  CFRelease(data);
+  if (!source || CGImageSourceGetCount(source) == 0) {
+    if (source) {
+      CFRelease(source);
+    }
+    return LexerResult(TerminalState::FAILURE);
+  }
+
+  CFDictionaryRef properties = CGImageSourceCopyPropertiesAtIndex(source, 0,
+                                                                  nullptr);
+  if (!properties) {
+    CFRelease(source);
+    return LexerResult(TerminalState::FAILURE);
+  }
+  auto readDimension = [properties](CFStringRef key) -> size_t {
+    CFNumberRef value = static_cast<CFNumberRef>(CFDictionaryGetValue(
+        properties, key));
+    int64_t dimension = 0;
+    if (!value || !CFNumberGetValue(value, kCFNumberSInt64Type, &dimension) ||
+        dimension <= 0 || dimension > kMaxImageDimension) {
+      return 0;
+    }
+    return static_cast<size_t>(dimension);
+  };
+  const size_t sourceWidth = readDimension(kCGImagePropertyPixelWidth);
+  const size_t sourceHeight = readDimension(kCGImagePropertyPixelHeight);
+  CFRelease(properties);
+  if (!sourceWidth || !sourceHeight ||
+      sourceWidth > kMaxDecodedBytes / 4 / sourceHeight) {
+    CFRelease(source);
+    return LexerResult(TerminalState::FAILURE);
+  }
+
+  const void* keys[] = {kCGImageSourceCreateThumbnailFromImageAlways,
+                        kCGImageSourceCreateThumbnailWithTransform,
+                        kCGImageSourceThumbnailMaxPixelSize};
+  const int maxDimension = static_cast<int>(std::max(sourceWidth, sourceHeight));
+  CFNumberRef maxPixelSize = CFNumberCreate(kCFAllocatorDefault,
+                                             kCFNumberIntType, &maxDimension);
+  if (!maxPixelSize) {
+    CFRelease(source);
+    return LexerResult(TerminalState::FAILURE);
+  }
+  const void* values[] = {kCFBooleanTrue, kCFBooleanTrue, maxPixelSize};
+  CFDictionaryRef options = CFDictionaryCreate(
+      kCFAllocatorDefault, keys, values, 3, &kCFTypeDictionaryKeyCallBacks,
+      &kCFTypeDictionaryValueCallBacks);
+  CFRelease(maxPixelSize);
+  if (!options) {
+    CFRelease(source);
+    return LexerResult(TerminalState::FAILURE);
+  }
+  CGImageRef image = CGImageSourceCreateThumbnailAtIndex(source, 0, options);
+  CFRelease(options);
+  CFRelease(source);
+  if (!image) {
+    return LexerResult(TerminalState::FAILURE);
+  }
+
+  const size_t width = CGImageGetWidth(image);
+  const size_t height = CGImageGetHeight(image);
+  if (!width || !height || width > kMaxImageDimension ||
+      height > kMaxImageDimension || width > kMaxDecodedBytes / 4 / height) {
+    CGImageRelease(image);
+    return LexerResult(TerminalState::FAILURE);
+  }
+  PostSize(static_cast<int32_t>(width), static_cast<int32_t>(height));
+  if (WantsFrameCount()) {
+    PostFrameCount(1);
+  }
+  if (IsMetadataDecode()) {
+    CGImageRelease(image);
+    return LexerResult(TerminalState::SUCCESS);
+  }
+
+  const size_t bytesPerRow = width * 4;
+  Vector<uint8_t> pixels;
+  if (!pixels.resize(bytesPerRow * height)) {
+    CGImageRelease(image);
+    return LexerResult(TerminalState::FAILURE);
+  }
+  CGColorSpaceRef colorSpace = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+  if (!colorSpace) {
+    CGImageRelease(image);
+    return LexerResult(TerminalState::FAILURE);
+  }
+  CGContextRef context = CGBitmapContextCreate(
+      pixels.begin(), width, height, 8, bytesPerRow, colorSpace,
+      kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big);
+  CGColorSpaceRelease(colorSpace);
+  if (!context) {
+    CGImageRelease(image);
+    return LexerResult(TerminalState::FAILURE);
+  }
+  CGContextTranslateCTM(context, 0, height);
+  CGContextScaleCTM(context, 1, -1);
+  CGContextDrawImage(context, CGRectMake(0, 0, width, height), image);
+  CGContextRelease(context);
+  if (CGImageGetAlphaInfo(image) != kCGImageAlphaNone &&
+      CGImageGetAlphaInfo(image) != kCGImageAlphaNoneSkipFirst &&
+      CGImageGetAlphaInfo(image) != kCGImageAlphaNoneSkipLast) {
+    PostHasTransparency();
+  }
+  CGImageRelease(image);
+
+  Maybe<SurfacePipe> pipe = SurfacePipeFactory::CreateSurfacePipe(
+      this, Size(), OutputSize(), FullFrame(), SurfaceFormat::R8G8B8A8,
+      SurfaceFormat::OS_RGBA, Nothing(), nullptr, SurfacePipeFlags());
+  if (!pipe) {
+    return LexerResult(TerminalState::FAILURE);
+  }
+  const uint32_t* row = reinterpret_cast<const uint32_t*>(pixels.begin());
+  for (size_t y = 0; y < height; ++y) {
+    const WriteState state = pipe->WriteBuffer(row + y * width);
+    if (state == WriteState::FAILURE) {
+      return LexerResult(TerminalState::FAILURE);
+    }
+    if (state == WriteState::FINISHED) {
+      break;
+    }
+  }
+  PostFrameStop();
+  PostDecodeDone();
+  return LexerResult(TerminalState::SUCCESS);
+}
+
+}  // namespace mozilla::image
