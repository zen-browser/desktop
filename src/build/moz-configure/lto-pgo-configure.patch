+@imports("os")
+def cs_profile_runtime(compiler, cs_profile):
+    if not cs_profile.generate:
+        return None
+
+    resource_dir = check_cmd_output(compiler.compiler, "--print-resource-dir").strip()
+    runtime = os.path.join(
+        resource_dir, "lib", "windows", "clang_rt.profile-x86_64.lib"
+    )
+    if not os.path.isfile(runtime):
+        die("Unable to find the context-sensitive profile runtime at %s" % runtime)
+    return runtime
+
