+option(
+    "--enable-cs-profile-generate",
+    help="Build a context-sensitive PGO instrumented binary",
+)
+
+option(
+    "--enable-cs-profile-use",
+    help="Use context-sensitive profile data during LTO",
+)
+
+
+@depends(
+    "--enable-cs-profile-generate",
+    "--enable-cs-profile-use",
+    "--enable-profile-use",
+    c_compiler,
+    target,
+    link,
+)
+@imports("os")
+def cs_profile_mode(generate, use, profile_use, compiler, target, linker_path):
+    generate = bool(generate)
+    use = bool(use)
+    if not generate and not use:
+        return namespace(generate=False, use=False)
+    if generate and use:
+        die("Cannot generate and use context-sensitive profiles in one build.")
+    if not profile_use or profile_use[0] != "cross":
+        die("Context-sensitive PGO requires --enable-profile-use=cross.")
+    if compiler.type != "clang-cl" or target.os != "WINNT" or target.cpu != "x86_64":
+        die("Context-sensitive PGO is only enabled for Windows x64.")
+    if not linker_path or not os.path.basename(linker_path).startswith("lld-link"):
+        die("Context-sensitive PGO requires lld-link.")
+    return namespace(generate=generate, use=use)
+
+
+@depends(enable_profile_generate, cs_profile_mode)
+def profile_generate_define(profile_generate, cs_profile):
+    return True if profile_generate or cs_profile.generate else None
+
+
+set_define("MOZ_PROFILE_GENERATE", profile_generate_define)
+
