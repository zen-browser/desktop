GeckoProgram("zen-firefox-password-import", linkage=None)
DIST_SUBDIR = ""
SOURCES += ["FirefoxPasswordImport.cpp"]
USE_LIBS += ["nspr", "nss"]

if CONFIG["OS_ARCH"] == "WINNT":
    WIN32_EXE_LDFLAGS += ["-SUBSYSTEM:CONSOLE", "-ENTRY:wmainCRTStartup"]
