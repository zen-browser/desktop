   Region: "resource://gre/modules/Region.sys.mjs",
   IDNService: {
     service: "@mozilla.org/network/idn-service;1",
     iid: Ci.nsIIDNService,
   },
+  QueryStringStripper: {
+    service: "@mozilla.org/url-query-string-stripper;1",
+    iid: Ci.nsIURLQueryStringStripper,
