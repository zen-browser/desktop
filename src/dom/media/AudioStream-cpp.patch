 void AudioStream::SetVolume(double aVolume) {
   TRACE_COMMENT("AudioStream::SetVolume", "%f", aVolume);
-  MOZ_ASSERT(aVolume >= 0.0 && aVolume <= 1.0, "Invalid volume");
+  MOZ_ASSERT(aVolume >= 0.0, "Invalid volume");
 
