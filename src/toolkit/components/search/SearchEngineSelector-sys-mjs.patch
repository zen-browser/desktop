   /**
+   * Astra ships a dump overlay (configs/dumps/search-config-v2.json) that adds
+   * global Yahoo and removes Wikipedia/eBay. A Remote Settings sync from
+   * Mozilla overwrites the local IDB with upstream search-config-v2, which
+   * drops Yahoo and restores Wikipedia/eBay — then SearchService falls back
+   * to Google and shows the "default search engine has been changed" toast.
+   *
+   * Re-apply the dump delta in-memory after every fetch/sync so the overlay
+   * survives without mutating signed Remote Settings records.
+   *
+   * @param {object[]} remoteRecords
+   * @returns {Promise<object[]>}
+   */
+  async #applyAstraDumpOverlay(remoteRecords) {
+    if (!Array.isArray(remoteRecords) || !remoteRecords.length) {
+      return remoteRecords;
+    }
+
+    let dump;
+    try {
+      ({ data: dump } = await lazy.SharedUtils.loadJSONDump(
+        "main",
+        "search-config-v2"
+      ));
+    } catch (e) {
+      lazy.logConsole.warn("Astra search dump overlay: load failed", e);
+      return remoteRecords;
+    }
+    if (!dump?.length) {
+      return remoteRecords;
+    }
+
+    const removeExact = new Set(["wikipedia", "ebay"]);
+    const removePrefixes = ["wikipedia-", "ebay-"];
+    const shouldRemove = id => {
+      if (!id) {
+        return false;
+      }
+      if (removeExact.has(id)) {
+        return true;
+      }
+      return removePrefixes.some(prefix => id.startsWith(prefix));
+    };
+
+    let result = remoteRecords.filter(r => !shouldRemove(r.identifier));
+    const present = new Set(result.map(r => r.identifier).filter(Boolean));
+    const remoteIds = new Set(
+      remoteRecords.map(r => r.identifier).filter(Boolean)
+    );
+
+    for (const rec of dump) {
+      const id = rec.identifier;
+      if (!id || present.has(id) || shouldRemove(id)) {
+        continue;
+      }
+      // Dump is a subset of upstream; only inject dump-only engines (Yahoo).
+      if (!remoteIds.has(id)) {
+        result.push(rec);
+        present.add(id);
+      }
+    }
+    return result;
+  }
