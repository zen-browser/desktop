  "sys/ZenActorsManager.sys.mjs",
  "sys/ZenAppIcon.sys.mjs",
  "sys/ZenCustomizableUI.sys.mjs",
  "sys/ZenUIMigration.sys.mjs",
]

EXTRA_JS_MODULES.zen.ui += [
  "sys/ui/ZenProgressBar.sys.mjs",
