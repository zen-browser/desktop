   #deferredBackupTask = null;
+  #lastSidebarFingerprint = "";
+  #cleanBackupCopied = false;
+
+  /**
+   * Forces the next save to rewrite the sidebar file. Mutations that are not
+   * yet visible on the SessionSaver snapshot should call this.
+   */
+  markSidebarDirty() {
+    this.#lastSidebarFingerprint = "";
+  }
+
+  #sidebarFingerprint(windows) {
+    const parts = [];
+    for (const win of windows) {
+      parts.push(
+        (win.spaces || [])
+          .map(space =>
+            [
+              space.uuid,
+              space.name,
+              space.icon,
+              space.containerTabId,
+              space.theme?.type,
+            ].join(":")
+          )
+          .join(",")
+      );
+      parts.push(
+        (win.folders || [])
+          .map(folder => [folder.id, folder.name, folder.workspaceId].join(":"))
+          .join(",")
+      );
+      parts.push(
+        (win.groups || []).map(group => group.id || "").join(","),
+        (win.splitViewData || [])
+          .map(split => split.groupId || split.id || "")
+          .join(",")
+      );
+      for (const tab of win.tabs || []) {
+        const entry = tab.entries?.[Math.max(0, (tab.index || 1) - 1)];
+        parts.push(
+          [
+            tab.zenSyncId,
+            tab.pinned ? 1 : 0,
+            tab.zenEssential ? 1 : 0,
+            tab._zenIsActiveTab ? 1 : 0,
+            entry?.url || "",
+          ].join(":")
+        );
+      }
+    }
+    return parts.join("\n");
+  }
 
