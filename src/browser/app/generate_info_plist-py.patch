+def _developer_repo_path():
+    # Development builds symlink engine/ files to ../src, and the content
+    # sandbox only reads below this path, so it must cover both. The packager
+    # strips the key from shipped builds.
+    parent = os.path.dirname(buildconfig.topsrcdir)
+    if os.path.isdir(os.path.join(parent, "src")):
+        return parent
+    return buildconfig.topsrcdir
