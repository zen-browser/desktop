 #include "AOMDecoder.h"
@@ -30,6 +31,25 @@
 using media::DecodeSupportSet;
 using media::MCSInfo;
 using media::MediaCodec;
+
+static bool IsAudioToolboxCodecAvailable(const nsACString& aMimeType) {
+  AudioFormatID formatID = 0;
+  if (aMimeType.EqualsLiteral("audio/alac")) {
+    formatID = kAudioFormatAppleLossless;
+  } else if (aMimeType.EqualsLiteral("audio/ac3")) {
+    formatID = kAudioFormatAC3;
+  } else if (aMimeType.EqualsLiteral("audio/eac3")) {
+    formatID = kAudioFormatEnhancedAC3;
+  } else {
+    return false;
+  }
+
+  UInt32 decoderListSize = 0;
+  return AudioFormatGetPropertyInfo(kAudioFormatProperty_Decoders,
+                                    sizeof(formatID), &formatID,
+                                    &decoderListSize) == noErr &&
+         decoderListSize >= sizeof(AudioClassDescription);
+}
 
