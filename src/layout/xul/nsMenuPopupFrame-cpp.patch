+mozilla::ColorScheme nsMenuPopupFrame::ResolveColorSchemeForTrigger() const {
+  if (mTriggerContent && !mTriggerContent->OwnerDoc()->IsContentDocument()) {
+    int32_t schemePref = Preferences::GetInt("zen.view.window.scheme", 2);
+    if (schemePref == 0) {
+      return LookAndFeel::ColorScheme::Dark;
+    }
+    if (schemePref == 1) {
+      return LookAndFeel::ColorScheme::Light;
+    }
+
+    RefPtr<nsAtom> zenDarkAtom = NS_Atomize("zen-should-be-dark-mode");
+    nsIContent* content = mTriggerContent;
+    while (content) {
+      if (content->IsElement()) {
+        nsAutoString darkMode;
+        if (content->AsElement()->GetAttr(kNameSpaceID_None, zenDarkAtom, darkMode)) {
+          if (darkMode.EqualsLiteral("true")) {
+            return LookAndFeel::ColorScheme::Dark;
+          }
+          if (darkMode.EqualsLiteral("false")) {
+            return LookAndFeel::ColorScheme::Light;
+          }
+        }
+      }
+      content = content->GetParent();
+    }
+
+    int32_t systemDark = 0;
+    if (NS_SUCCEEDED(LookAndFeel::GetInt(LookAndFeel::IntID::SystemUsesDarkTheme,
+                                         &systemDark)) &&
+        systemDark) {
+      return LookAndFeel::ColorScheme::Dark;
+    }
+
+    if (nsIFrame* triggerFrame = mTriggerContent->GetPrimaryFrame()) {
+      return LookAndFeel::ColorSchemeForFrame(triggerFrame);
+    }
+  }
+  return LookAndFeel::ColorSchemeForFrame(this);
+}
+
+void nsMenuPopupFrame::UpdateColorSchemeForTooltip() {
+  // Si c'est une tooltip Chrome (hors contenu web)
+  if (IsTooltip() && mTriggerContent &&
+      !mTriggerContent->OwnerDoc()->IsContentDocument()) {
+    LookAndFeel::ColorScheme triggerScheme = ResolveColorSchemeForTrigger();
+    if (nsIWidget* widget = GetWidget()) {
+      widget->SetColorScheme(Some(triggerScheme));
+    }
+
+    // Positionner l'attribut pour le CSS
+    if (Element* popupElem = GetContent()->AsElement()) {
+      popupElem->SetAttr(kNameSpaceID_None, nsGkAtoms::scheme,
+                         triggerScheme == LookAndFeel::ColorScheme::Dark
+                             ? u"dark"_ns
+                             : u"light"_ns,
+                         true);
+    }
+  }
+}
+
+void nsMenuPopupFrame::UpdateCornerForTooltip(const nsRect& aUsedRect) {
+  if (!mTriggerContent) {
+    return;
+  }
+  nsRect triggerRect;
+  if (nsIFrame* triggerFrame = mTriggerContent->GetPrimaryFrame()) {
+    triggerRect = triggerFrame->GetScreenRectInAppUnits();
+  } else {
+    triggerRect = mScreenRect;
+  }
+
+  // Four corners of the tooltip used rect:
+  nsPoint corners[4] = {
+      nsPoint(aUsedRect.x, aUsedRect.y),
+      nsPoint(aUsedRect.XMost(), aUsedRect.y),
+      nsPoint(aUsedRect.x, aUsedRect.YMost()),
+      nsPoint(aUsedRect.XMost(), aUsedRect.YMost()),
+  };
+
+  const char16_t* cornerNames[4] = {
+      u"top-left",
+      u"top-right",
+      u"bottom-left",
+      u"bottom-right",
+  };
+
+  int64_t minDistSq = -1;
+  size_t bestCorner = 0;
+
+  for (size_t i = 0; i < 4; ++i) {
+    const nsPoint& c = corners[i];
+    nscoord dx = 0;
+    if (c.x < triggerRect.x) {
+      dx = triggerRect.x - c.x;
+    } else if (c.x > triggerRect.XMost()) {
+      dx = c.x - triggerRect.XMost();
+    }
+
+    nscoord dy = 0;
+    if (c.y < triggerRect.y) {
+      dy = triggerRect.y - c.y;
+    } else if (c.y > triggerRect.YMost()) {
+      dy = c.y - triggerRect.YMost();
+    }
+
+    int64_t distSq = static_cast<int64_t>(dx) * dx + static_cast<int64_t>(dy) * dy;
+    if (minDistSq < 0 || distSq < minDistSq) {
+      minDistSq = distSq;
+      bestCorner = i;
+    }
+  }
+
+  if (Element* popupElem = GetContent()->AsElement()) {
+    RefPtr<nsAtom> cornerAtom = NS_Atomize("corner");
+    popupElem->SetAttr(kNameSpaceID_None, cornerAtom,
+                       nsDependentString(cornerNames[bestCorner]), true);
+  }
+}
