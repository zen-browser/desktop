+bool nsCocoaWindow::HandlePictureInPictureTrackpadGesture(NSEvent* aEvent) {
+  if (!mIsPictureInPictureWindow || mInFullScreenMode || !mWindow) {
+    return false;
+  }
+  bool isPan = aEvent.type == NSEventTypeScrollWheel;
+  if (isPan && (!aEvent.hasPreciseScrollingDeltas ||
+                (aEvent.phase == NSEventPhaseNone &&
+                 aEvent.momentumPhase == NSEventPhaseNone) ||
+                (aEvent.modifierFlags &
+                 (NSEventModifierFlagControl | NSEventModifierFlagOption |
+                  NSEventModifierFlagCommand | NSEventModifierFlagShift)))) {
+    return false;
+  }
+  if (isPan && (aEvent.momentumPhase != NSEventPhaseNone ||
+                !(aEvent.phase & (NSEventPhaseBegan | NSEventPhaseChanged)))) {
+    return true;
+  }
+  if (!isPan && !(aEvent.phase & (NSEventPhaseBegan | NSEventPhaseChanged))) {
+    return true;
+  }
+
+  NSRect frame = mWindow.frame;
+  NSRect originalFrame = frame;
+  NSRect available = mWindow.screen.visibleFrame;
+  if (isPan) {
+    frame.origin.x += aEvent.scrollingDeltaX;
+    frame.origin.y -= aEvent.scrollingDeltaY;
+  } else {
+    // Keep subpixel geometry instead of feeding AppKit's rounded frame back in.
+    if (NSEqualRects(frame, mPictureInPictureLastPinchFrame)) {
+      frame = mPictureInPicturePinchFrame;
+    }
+    originalFrame = frame;
+    CGFloat ratio = frame.size.width / frame.size.height;
+    CGFloat maxWidth =
+        std::min(available.size.width, available.size.height * ratio);
+    CGFloat minWidth = std::min(
+        maxWidth,
+        std::max(std::max(CGFloat(120), mWindow.minSize.width),
+                 std::max(CGFloat(80), mWindow.minSize.height) * ratio));
+    CGFloat width = std::clamp(
+        frame.size.width * std::exp(aEvent.magnification), minWidth, maxWidth);
+    frame.size = NSMakeSize(width, width / ratio);
+    frame.origin.x += (originalFrame.size.width - frame.size.width) / 2;
+    frame.origin.y += (originalFrame.size.height - frame.size.height) / 2;
+    mPictureInPicturePinchFrame = frame;
+  }
+  frame.origin.x = std::clamp(
+      frame.origin.x, NSMinX(available),
+      std::max(NSMinX(available), NSMaxX(available) - frame.size.width));
+  frame.origin.y = std::clamp(
+      frame.origin.y, NSMinY(available),
+      std::max(NSMinY(available), NSMaxY(available) - frame.size.height));
+  NSPoint cursor = NSEvent.mouseLocation;
+  [mWindow setFrame:frame display:NO];
+  if (!isPan) {
+    mPictureInPictureLastPinchFrame = mWindow.frame;
+  }
+  if (isPan) {
+    NSRect actualFrame = mWindow.frame;
+    cursor.x += actualFrame.origin.x - originalFrame.origin.x;
+    cursor.y += actualFrame.origin.y - originalFrame.origin.y;
+    // Quartz uses a top-left origin; AppKit uses the primary screen's
+    // bottom-left.
+    CGFloat screenTop = NSMaxY(NSScreen.screens.firstObject.frame);
+    CGWarpMouseCursorPosition(CGPointMake(cursor.x, screenTop - cursor.y));
+  }
+  return true;
+}
