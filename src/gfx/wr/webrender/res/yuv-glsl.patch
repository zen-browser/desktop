+// Multi-tap bilinear supersampling for YUV video downscaling beyond 2x
+// (e.g. 1440p/4K video rendered in a small Picture-in-Picture window).
+// Each bilinear tap covers a 2x2 texel footprint, so 2x2 / 3x3 / 4x4 taps
+// cover up to ~4x / ~6x / ~8x downscaling without requiring mipmaps on
+// dynamic or external DMABUF/VA-API video surfaces.
+vec4 sample_yuv_plane_downscale(
+    YUV_SAMPLER_TYPE s,
+    vec2 uv,
+    vec2 dx,
+    vec2 dy,
+    vec4 bounds,
+    float scale_sq
+) {
+    if (scale_sq <= 4.0) {
+        return TEX_SAMPLE_YUV_LOD0(s, clamp(uv, bounds.xy, bounds.zw));
+    }
+
+    if (scale_sq <= 16.0) {
+        vec2 hx = 0.25 * dx;
+        vec2 hy = 0.25 * dy;
+        vec4 sum = TEX_SAMPLE_YUV_LOD0(s, clamp(uv - hx - hy, bounds.xy, bounds.zw))
+                 + TEX_SAMPLE_YUV_LOD0(s, clamp(uv + hx - hy, bounds.xy, bounds.zw))
+                 + TEX_SAMPLE_YUV_LOD0(s, clamp(uv - hx + hy, bounds.xy, bounds.zw))
+                 + TEX_SAMPLE_YUV_LOD0(s, clamp(uv + hx + hy, bounds.xy, bounds.zw));
+        return 0.25 * sum;
+    }
+
+    if (scale_sq <= 36.0) {
+        vec2 sx = (1.0 / 3.0) * dx;
+        vec2 sy = (1.0 / 3.0) * dy;
+        vec4 sum = vec4(0.0);
+        for (int iy = -1; iy <= 1; iy++) {
+            vec2 row_uv = uv + float(iy) * sy;
+            sum += TEX_SAMPLE_YUV_LOD0(s, clamp(row_uv - sx, bounds.xy, bounds.zw));
+            sum += TEX_SAMPLE_YUV_LOD0(s, clamp(row_uv,      bounds.xy, bounds.zw));
+            sum += TEX_SAMPLE_YUV_LOD0(s, clamp(row_uv + sx, bounds.xy, bounds.zw));
+        }
+        return (1.0 / 9.0) * sum;
+    }
+
+    vec4 sum = vec4(0.0);
+    for (int iy = 0; iy < 4; iy++) {
+        float oy = (float(iy) - 1.5) * 0.25;
+        vec2 row_uv = uv + oy * dy;
+        sum += TEX_SAMPLE_YUV_LOD0(s, clamp(row_uv - 0.375 * dx, bounds.xy, bounds.zw));
+        sum += TEX_SAMPLE_YUV_LOD0(s, clamp(row_uv - 0.125 * dx, bounds.xy, bounds.zw));
+        sum += TEX_SAMPLE_YUV_LOD0(s, clamp(row_uv + 0.125 * dx, bounds.xy, bounds.zw));
+        sum += TEX_SAMPLE_YUV_LOD0(s, clamp(row_uv + 0.375 * dx, bounds.xy, bounds.zw));
+    }
+    return 0.0625 * sum;
+}
+
+YUV_PRECISION vec3 sample_yuv_multitap(
+    int format,
+    vec2 in_uv_y,
+    vec2 in_uv_u,
+    vec2 in_uv_v,
+    vec4 uv_bounds_y,
+    vec4 uv_bounds_u,
