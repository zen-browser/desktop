+const DOWNLOAD_FOLDERS_PREF = "zen.downloads.container-folders";
+const { FileUtils } = ChromeUtils.importESModule(
+  "resource://gre/modules/FileUtils.sys.mjs"
+);
+
+function readDownloadFolders() {
+  try {
+    const folders = JSON.parse(
+      Services.prefs.getStringPref(DOWNLOAD_FOLDERS_PREF, "{}")
+    );
+    return folders && typeof folders == "object" ? folders : {};
+  } catch (error) {
+    console.error("Invalid container download folder settings", error);
+    return {};
+  }
+}
+
+function writeDownloadFolders(folders) {
+  Services.prefs.setStringPref(DOWNLOAD_FOLDERS_PREF, JSON.stringify(folders));
+}
+
+function getDownloadFolder(userContextId) {
+  const folders = readDownloadFolders();
+  const folder = folders[String(userContextId)];
+  return typeof folder == "string" ? folder : "";
+}
+
+async function chooseDownloadFolder(userContextId) {
+  const title = await document.l10n.formatValue(
+    "zen-download-folder-choose"
+  );
+  const picker = Cc["@mozilla.org/filepicker;1"].createInstance(
+    Ci.nsIFilePicker
+  );
+  picker.init(window.browsingContext, title, Ci.nsIFilePicker.modeGetFolder);
+
+  const currentFolder = getDownloadFolder(userContextId);
+  if (currentFolder) {
+    try {
+      picker.displayDirectory = new FileUtils.File(currentFolder);
+    } catch (error) {
+      console.error("Failed to open the current download folder", error);
+    }
+  }
+
+  picker.open(result => {
+    if (result != Ci.nsIFilePicker.returnOK || !picker.file) {
+      return;
+    }
+
+    const folders = readDownloadFolders();
+    folders[String(userContextId)] = picker.file.path;
+    writeDownloadFolders(folders);
+  });
+}
+
+function clearDownloadFolder(userContextId) {
+  const folders = readDownloadFolders();
+  delete folders[String(userContextId)];
+  writeDownloadFolders(folders);
+}
+
