+bool MediaStatusManager::UpdateTopLevelDelegation() {
+  const auto previous = mTopLevelDelegateContextId;
+  auto info = mMediaSessionInfoMap.Lookup(mTopLevelBrowsingContextId);
+  if (!mActiveMediaSessionContextId ||
+      *mActiveMediaSessionContextId == mTopLevelBrowsingContextId || !info ||
+      info->mDeclaredPlaybackState == MediaSessionPlaybackState::None) {
+    mTopLevelDelegateContextId.reset();
+  } else if (info->mDeclaredPlaybackState ==
+             MediaSessionPlaybackState::Playing) {
+    mTopLevelDelegateContextId = mActiveMediaSessionContextId;
+  } else if (mTopLevelDelegateContextId != mActiveMediaSessionContextId) {
+    // A pre-existing paused session must not capture a newly selected player.
+    mTopLevelDelegateContextId.reset();
+  }
+  return previous != mTopLevelDelegateContextId;
+}
+
+bool MediaStatusManager::HasTopLevelDelegation() const {
+  return mTopLevelDelegateContextId &&
+         mTopLevelDelegateContextId == mActiveMediaSessionContextId;
+}
