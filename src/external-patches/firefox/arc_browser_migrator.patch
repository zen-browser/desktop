+++ b/browser/components/migration/ArcMigrationUtils.sys.mjs
@@ -0,0 +1,193 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { MigrationUtils } from "moz-src:///browser/components/migration/MigrationUtils.sys.mjs";
+
+const lazy = {};
+
+ChromeUtils.defineESModuleGetters(lazy, {
+  PlacesUtils: "resource://gre/modules/PlacesUtils.sys.mjs",
+});
+
+export var ArcMigrationUtils = {
+  /**
+   * Converts the contents of Arc's StorableSidebar.json into bookmark trees
+   * that can be passed to PlacesUtils.bookmarks.insertTree: the profile's
+   * Favorites as bookmarks, followed by one folder per space. Only the pinned
+   * section of each space is converted; unpinned tabs are transient and Arc
+   * archives them automatically. Entries that are malformed or have URLs that
+   * cannot be bookmarked are skipped.
+   *
+   * @param {object} sidebarJSON
+   *   The parsed contents of StorableSidebar.json.
+   * @param {string} profileId
+   *   The Chromium profile directory name (e.g. "Default", "Profile 1") whose
+   *   Favorites and spaces should be returned.
+   * @returns {Promise<object[]>}
+   */
+  async convertSidebar(sidebarJSON, profileId) {
+    let asArray = value => (Array.isArray(value) ? value : []);
+    let asString = value => (typeof value === "string" ? value : "");
+
+    // Arc encodes ordered dictionaries as flat [key, value, key, value] arrays.
+    // The containers are keyed by window type; only the main "global" sidebar
+    // is imported, not "littleBrowser" windows.
+    let containers = asArray(sidebarJSON?.sidebar?.containers);
+    let globalIndex = containers.findIndex(
+      c => c && typeof c === "object" && "global" in c
+    );
+    let container = globalIndex === -1 ? null : containers[globalIndex + 1];
+    if (!Array.isArray(container?.spaces) || !Array.isArray(container?.items)) {
+      return [];
+    }
+
+    let toMap = list =>
+      new Map(
+        list
+          .filter(v => v && typeof v === "object" && typeof v.id === "string")
+          .map(v => [v.id, v])
+      );
+    let spaces = toMap(container.spaces);
+    let items = toMap(container.items);
+
+    let toBookmarkURL = value => {
+      let url = URL.parse(asString(value).trim());
+      if (
+        !url ||
+        !["http:", "https:", "ftp:", "file:"].includes(url.protocol)
+      ) {
+        return null;
+      }
+      return url.href;
+    };
+
+    let convertItems = (ids, visited) => {
+      let result = [];
+      for (let id of asArray(ids)) {
+        let item = items.get(id);
+        if (!item || visited.has(id)) {
+          continue;
+        }
+        visited.add(id);
+        let data = item.data && typeof item.data === "object" ? item.data : {};
+        if (data.tab) {
+          let url = toBookmarkURL(data.tab.savedURL);
+          if (url) {
+            result.push({
+              url,
+              title: asString(item.title) || asString(data.tab.savedTitle),
+            });
+          }
+        } else if (data.list) {
+          let children = convertItems(item.childrenIds, visited);
+          if (children.length) {
+            result.push({
+              type: lazy.PlacesUtils.bookmarks.TYPE_FOLDER,
+              title: asString(item.title),
+              children,
+            });
+          }
+        } else {
+          // Split views and other groupings: keep their tabs, drop the grouping.
+          result.push(...convertItems(item.childrenIds, visited));
+        }
+      }
+      return result;
+    };
+
+    let isProfile = profile =>
+      (profile?.default
+        ? "Default"
+        : (profile?.custom?._0?.directoryBasename ?? "Default")) === profileId;
+
+    let result = [];
+    let topApps = asArray(container.topAppsContainerIDs);
+    for (let i = 0; i + 1 < topApps.length; i += 2) {
+      if (isProfile(topApps[i])) {
+        result.push(
+          ...convertItems(items.get(topApps[i + 1])?.childrenIds, new Set())
+        );
+      }
+    }
+
+    let spaceNumber = 0;
+    for (let space of spaces.values()) {
+      if (!isProfile(space.profile)) {
+        continue;
+      }
+      spaceNumber++;
+
+      let containerIDs = asArray(space.containerIDs);
+      let pinnedIndex = containerIDs.indexOf("pinned");
+      let pinnedRoot =
+        pinnedIndex === -1 ? null : items.get(containerIDs[pinnedIndex + 1]);
+      if (!pinnedRoot) {
+        continue;
+      }
+
+      let children = convertItems(pinnedRoot.childrenIds, new Set());
+      if (children.length) {
+        result.push({
+          type: lazy.PlacesUtils.bookmarks.TYPE_FOLDER,
+          title:
+            asString(space.title) ||
+            (await MigrationUtils.getLocalizedString(
+              "migration-imported-arc-untitled-space",
+              { number: spaceNumber }
+            )),
+          children,
+        });
+      }
+    }
+    return result;
+  },
+
+  /**
+   * Returns a bookmarks migration resource that imports a profile's Favorites
+   * and spaces from Arc's StorableSidebar.json onto the bookmarks toolbar.
+   *
+   * @param {string} sidebarPath
+   *   The path to StorableSidebar.json.
+   * @param {string} profileId
+   *   The Chromium profile directory name (e.g. "Default", "Profile 1").
+   * @returns {Promise<object|null>}
+   *   The resource, or null if the file is missing, unreadable or has nothing
+   *   to import for this profile.
+   */
+  async getSidebarResource(sidebarPath, profileId) {
+    let bookmarks;
+    try {
+      let sidebarJSON = await IOUtils.readJSON(sidebarPath);
+      bookmarks = await this.convertSidebar(sidebarJSON, profileId);
+    } catch (ex) {
+      if (!DOMException.isInstance(ex) || ex.name !== "NotFoundError") {
+        console.error("Could not read Arc spaces from", sidebarPath, ex);
+      }
+      return null;
+    }
+
+    if (!bookmarks.length) {
+      return null;
+    }
+
+    return {
+      type: MigrationUtils.resourceTypes.BOOKMARKS,
+
+      async migrate(aCallback) {
+        let success = false;
+        try {
+          await MigrationUtils.insertManyBookmarksWrapper(
+            bookmarks,
+            lazy.PlacesUtils.bookmarks.toolbarGuid,
+            { fixupOrSkipInvalidEntries: true }
+          );
+          success = true;
+        } catch (ex) {
+          console.error(ex);
+        }
+        aCallback(success);
+      },
+    };
+  },
+};
