@@ -542,6 +542,37 @@ nsresult nsXULTooltipListener::FindTooltip(nsIContent* aTarget,
 
   // non-XUL elements should just use the default tooltip
   if (!aTarget->IsXULElement()) {
+    if (!document->IsContentDocument()) {
+      nsAutoString text;
+      if (aTarget->IsElement()) {
+        aTarget->AsElement()->GetAttr(nsGkAtoms::tooltiptext, text);
+        if (text.IsEmpty()) {
+          aTarget->AsElement()->GetAttr(nsGkAtoms::title, text);
+        }
+      }
+      nsIContent* parent = aTarget->GetParent();
+      uint32_t depth = 0;
+      while (parent && text.IsEmpty() && depth++ < 15) {
+        if (parent->IsElement()) {
+          if (parent->AsElement()->HasAttr(nsGkAtoms::tooltip)) {
+            break;
+          }
+          parent->AsElement()->GetAttr(nsGkAtoms::tooltiptext, text);
+          if (text.IsEmpty()) {
+            parent->AsElement()->GetAttr(nsGkAtoms::title, text);
+          }
+        }
+        parent = parent->GetParent();
+      }
+      if (!text.IsEmpty()) {
+        if (RefPtr<Element> tooltip =
+                document->GetElementById(u"dynamic-shortcut-tooltip"_ns)) {
+          tooltip->SetAttr(kNameSpaceID_None, nsGkAtoms::label, text, true);
+          tooltip.forget(aTooltip);
+          return NS_OK;
+        }
+      }
+    }
     nsIPopupContainer* popupContainer =
         nsIPopupContainer::GetPopupContainer(document->GetPresShell());
     NS_ENSURE_STATE(popupContainer);
