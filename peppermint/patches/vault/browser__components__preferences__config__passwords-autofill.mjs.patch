+function observeVault(emitChange) {
+  const topics = ["peppermint-vault-state", "passwordmgr-primary-pw-changed"];
+  const pref = "peppermint.vault.enabled";
+  for (const topic of topics) {
+    Services.obs.addObserver(emitChange, topic);
+  }
+  Services.prefs.addObserver(pref, emitChange);
+  return () => {
+    for (const topic of topics) {
+      Services.obs.removeObserver(emitChange, topic);
+    }
+    Services.prefs.removeObserver(pref, emitChange);
+  };
+}
+
+Preferences.addSetting({
+  id: "peppermintVaultSetUp",
+  setup: observeVault,
+  visible: () => !lazy.PeppermintVault.isEnabled,
+  disabled: () => !lazy.PeppermintVault.canEnable.allowed,
+  onUserClick: async () => {
+    const chromeWindow = window.browsingContext.topChromeWindow;
+    if (await lazy.PeppermintVault.promptOptIn(chromeWindow)) {
+      lazy.PeppermintVault.open(chromeWindow);
+    }
   },
 });
 
 Preferences.addSetting({
