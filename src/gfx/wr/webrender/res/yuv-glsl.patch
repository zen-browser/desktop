+    vec2 dx_y,
+    vec2 dy_y,
+    float scale_y_sq
+) {
+    YUV_PRECISION vec3 ycbcr_sample;
+    if (format == YUV_FORMAT_PLANAR) {
+        vec2 dx_u = dFdx(in_uv_u);
+        vec2 dy_u = dFdy(in_uv_u);
+        vec2 dx_v = dFdx(in_uv_v);
+        vec2 dy_v = dFdy(in_uv_v);
+        vec2 tex_size_u = TEX_SIZE_YUV(sColor1);
+        vec2 tex_size_v = TEX_SIZE_YUV(sColor2);
+        vec2 su_x = dx_u * tex_size_u;
+        vec2 su_y = dy_u * tex_size_u;
+        vec2 sv_x = dx_v * tex_size_v;
+        vec2 sv_y = dy_v * tex_size_v;
+        float scale_u_sq = max(dot(su_x, su_x), dot(su_y, su_y));
+        float scale_v_sq = max(dot(sv_x, sv_x), dot(sv_y, sv_y));
+        ycbcr_sample.x = sample_yuv_plane_downscale(sColor0, in_uv_y, dx_y, dy_y, uv_bounds_y, scale_y_sq).r;
+        ycbcr_sample.y = sample_yuv_plane_downscale(sColor1, in_uv_u, dx_u, dy_u, uv_bounds_u, scale_u_sq).r;
+        ycbcr_sample.z = sample_yuv_plane_downscale(sColor2, in_uv_v, dx_v, dy_v, uv_bounds_v, scale_v_sq).r;
+    } else if (yuv_format_is_biplanar(format)) {
+        vec2 dx_u = dFdx(in_uv_u);
+        vec2 dy_u = dFdy(in_uv_u);
+        vec2 tex_size_u = TEX_SIZE_YUV(sColor1);
+        vec2 su_x = dx_u * tex_size_u;
+        vec2 su_y = dy_u * tex_size_u;
+        float scale_u_sq = max(dot(su_x, su_x), dot(su_y, su_y));
+        ycbcr_sample.x = sample_yuv_plane_downscale(sColor0, in_uv_y, dx_y, dy_y, uv_bounds_y, scale_y_sq).r;
+        ycbcr_sample.yz = sample_yuv_plane_downscale(sColor1, in_uv_u, dx_u, dy_u, uv_bounds_u, scale_u_sq).rg;
+    } else if (format == YUV_FORMAT_INTERLEAVED) {
+        ycbcr_sample = sample_yuv_plane_downscale(sColor0, in_uv_y, dx_y, dy_y, uv_bounds_y, scale_y_sq).gbr;
+    } else {
+        ycbcr_sample = vec3(0.0);
+    }
+    return ycbcr_sample;
+}
