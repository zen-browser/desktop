+
+
+def wait_for_profile_unlock(profile_path, timeout=30):
+    # The run before this one has just quit, and a profile it still holds
+    # would turn this launch into an "already running" dialog that exits
+    # straight away. Gecko drops these on a clean unlock.
+    locks = [os.path.join(profile_path, name) for name in ("lock", "parent.lock")]
+    deadline = time.monotonic() + timeout
+    while any(os.path.lexists(lock) for lock in locks):
+        if time.monotonic() > deadline:
+            print(
+                "profile is still locked after %ds, starting anyway" % timeout,
+                flush=True,
+            )
+            return
+        time.sleep(0.25)
+
+
