 }
@@ -799,6 +802,16 @@ long AudioStream::DataCallback(void* aBuffer, long aFrames) {
                                    mAudioThreadChanged);
   }
 
+  if (float gain = mSoftwareGain; gain != 1.0f) {
+    uint32_t frames = static_cast<uint32_t>(aFrames) - writer.Available();
+    Span<AudioDataValue> samples(static_cast<AudioDataValue*>(aBuffer),
+                                 frames * mOutChannels);
+    for (AudioDataValue& sample : samples) {
+      sample = FloatToAudioSample<AudioDataValue>(
+          Clip(ConvertAudioSample<float>(sample) * gain));
+    }
+  }
+
   mDumpFile.Write(static_cast<const AudioDataValue*>(aBuffer),
                   aFrames * mOutChannels);
 
