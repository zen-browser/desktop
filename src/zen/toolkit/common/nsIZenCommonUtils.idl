#include "nsISupports.idl"
#include "nsIURI.idl"

interface mozIDOMWindowProxy;

/**
 * @brief Common utility functions for Zen.
 */
[scriptable, uuid(d034642a-43b1-4814-be1c-8ad75e337c84)]
interface nsIZenCommonUtils : nsISupports {
  /*
   * @brief Share using the native share dialog.
   * @param window The window to use for the share dialog.
   * @param url The URL to share.
   * @param title The title of the share.
   * @param text The text to share.
   * @param x The x coordinate of the share dialog.
   * @param y The y coordinate of the share dialog.
   * @returns A promise that resolves when the share is complete.
   */
  void share(in nsIURI url, in ACString title, in ACString text,
             in uint32_t x, in uint32_t y, in uint32_t width, in uint32_t height);
  /*
   * @brief Check if the current context can share data.
   * @param window The window to check.
   * @returns True if the current context can share data, false otherwise.
   */
  boolean canShare();
  /*
   * @brief Play a single haptic feedback note if supported.
   */
  void playHapticFeedback();
  /*
   * @brief Bring the application whose windows are right behind this one's
   * forward. Only on macOS.
   */
  void returnToPreviousApplication();
  /*
   * @brief A window is about to open for a link sent by another application.
   * Keep the other windows of this application behind that one, although the
   * link activated this application. Only on macOS.
   */
  void keepWindowsBehindPreviousApplication();
  /*
   * @brief Let a window that has not been shown yet appear on top of other
   * applications' fullscreen Spaces, on whichever Space the user is on when
   * it is shown. Only on macOS. The window must also have
   * macnativefullscreen="false".
   */
  void prepareFloatingWindow(in mozIDOMWindowProxy window);
  /*
   * @brief Make a window prepared with prepareFloatingWindow() key once it is
   * shown, and keep it on the Space it was shown on. Only on macOS.
   */
  void presentFloatingWindow(in mozIDOMWindowProxy window);
};
