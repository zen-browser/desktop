 const { ExtensionError, promiseTimeout } = ExtensionUtils;
 
+// Errors can arrive from the subprocess worker as plain objects when the
+// original error could not be structured-cloned (gh-15432). Normalize them so
+// that error reporting keeps a useful message and the ClonedErrorHolder used
+// to forward disconnect errors to extensions does not throw, which would
+// leave the port connected forever with no error visible anywhere.
+function toError(err) {
+  if (!err || err instanceof Error || DOMException.isInstance(err)) {
+    return err;
+  }
+  let error = new ExtensionError(`${err?.message ?? err}`);
+  if (err?.errorCode !== undefined) {
+    error.errorCode = err.errorCode;
+  }
+  return error;
+}
