+  
+  /**
+   * Creates and copies a URL with a text fragment for the selected text.
+   * This allows linking directly to the selected text on the page.
+   */
+  copyLinkToTextFragment() {
+    // Get the selected text from the current page
+    let selectedText = this.browser.contentWindow.getSelection().toString().trim();
+    
+    if (!selectedText) {
+      return;
+    }
+    
+    // Encode the selected text for use in a URL fragment
+    // We must follow the Text Fragments spec rules:
+    // - Escape special characters
+    // - Truncate if too long (max ~120 chars recommended)
+    const MAX_FRAGMENT_LENGTH = 120;
+    if (selectedText.length > MAX_FRAGMENT_LENGTH) {
+      selectedText = selectedText.substring(0, MAX_FRAGMENT_LENGTH);
+    }
+    
+    // Encode the text for URL use
+    const encodedText = encodeURIComponent(selectedText);
+    
+    // Get the current URL and add the text fragment
+    let currentUrl = this.browser.currentURI.spec;
+    
+    // Remove any existing text fragment
+    if (currentUrl.includes("#:~:")) {
+      currentUrl = currentUrl.split("#:~:")[0];
+    }
+    
+    // Remove any existing fragment
+    if (currentUrl.includes("#")) {
+      currentUrl = currentUrl.split("#")[0];
+    }
+    
+    // Create the new URL with text fragment
+    const urlWithFragment = `${currentUrl}#:~:text=${encodedText}`;
+    
+    // Copy the URL to clipboard
+    Cc["@mozilla.org/widget/clipboardhelper;1"]
+      .getService(Ci.nsIClipboardHelper)
+      .copyString(urlWithFragment);
+    
+    // Show a notification
+    this.showNotificationInParent("linkToTextFragmentCopied");
+  }

