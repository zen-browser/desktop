+      while (remaining.length > 0) {
+        let foundMod = modifiers.find(m => remaining.startsWith(m));
+        if (foundMod) {
+          keys.push(foundMod);
+          remaining = remaining.slice(foundMod.length);
+        } else {
+          keys.push(remaining);
